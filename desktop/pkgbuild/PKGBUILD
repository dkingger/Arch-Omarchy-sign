pkgname=arch-sign
pkgver=0.1.0
pkgrel=11
pkgdesc='Color control for the Arch Omarchy LED sign'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'hyprpicker' 'qt6-svg')
makedepends=('gcc' 'make')
source=()
sha256sums=()
build() {
  cd "$startdir/.."
  ./bin/build
}
package() {
  cd "$startdir/.."
  install -Dm755 build/arch-sign "$pkgdir/usr/bin/arch-sign"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/arch-sign.desktop "$pkgdir/usr/share/applications/arch-sign.desktop"
  install -Dm644 pkgbuild/arch-sign.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/arch-sign.svg"
}
