[Unit]
Description=Arch Omarchy Sign Theme Sync
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/.config/arch-sign/config.json

[Service]
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /usr/lib/arch-sign/theme_sync.py --config %h/.config/arch-sign/config.json
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
